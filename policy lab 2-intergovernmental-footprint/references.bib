@article{grose2015,
	title = {Explaining Explanations: How Legislators Explain their Policy Positions and How Citizens React},
	volume = {59},
	issn = {0092-5853, 1540-5907},
	url = {https://onlinelibrary.wiley.com/doi/10.1111/ajps.12164},
	doi = {10.1111/ajps.12164},
	shorttitle = {Explaining Explanations},
	abstract = {Legislators claim that how they
              explain
              their votes matters as much as or more than the roll calls themselves. However, few studies have systematically examined legislators’ explanations and citizen attitudes in response to these explanations. We theorize that legislators strategically tailor explanations to constituents in order to compensate for policy choices that are incongruent with constituent preferences, and to reinforce policy choices that are congruent. We conduct a within‐subjects field experiment using U.S. senators as subjects to test this hypothesis. We then conduct a between‐subjects survey experiment of ordinary people to see how they react to the explanatory strategies used by senators in the field experiment. We find that most senators tailor their explanations to their audiences, and that these tailored explanations are effective at currying support—especially among people who disagree with the legislators’ roll‐call positions.},
	pages = {724--743},
	number = {3},
	journaltitle = {American Journal of Political Science},
	shortjournal = {American J Political Sci},
	author = {Grose, Christian R. and Malhotra, Neil and Parks Van Houweling, Robert},
	urldate = {2026-09-10},
	date = {2015-07},
	langid = {english},
	keywords = {notion},
	file = {Grose et al.-2015-American Journal of Political Science-Explaining Explanations How Legislators Explain their Policy Positions and How Citizens React.pdf:/Users/jodypark/Library/CloudStorage/Dropbox/Zotero/Penn State/Fall 2026/PPOL805 Bureaucracy/Grose et al.-2015-American Journal of Political Science-Explaining Explanations How Legislators Explain their Policy Positions and How Citizens React.pdf:application/pdf},
}

