@article{liu2025,
	title = {Bureaucratic Access in National Policy Agenda Setting Process: Participation, dispersion, and centrality},
	volume = {53},
	issn = {0190-292X, 1541-0072},
	url = {https://onlinelibrary.wiley.com/doi/10.1111/psj.70023},
	doi = {10.1111/psj.70023},
	shorttitle = {Bureaucratic Access in National Policy Agenda Setting Process},
	abstract = {Drawing insights from past scholarship, this paper offers theoretical expectations and empirical measures to examine federal bureaucrats' access to the congressional pre-legislation agendasetting process on the issue of global warming and climate change ({GWCC}). Based on an original dataset covering all congressional {GWCC} hearings and testimonies from 1976 to 2007, we employ both traditional indicators and two new measures to assess three key elements of congressional agenda access—participation, dispersion, and centrality – and further test the hypotheses derived from our conceptual and theoretical arguments. Our analyses provide strong and persistent evidence, revealing that the federal bureaucracy, relative to other types of witness groups (e.g., academia, industry, and non-profit), was the most frequent, dispersive, and central player in the congressional {GWCC} agenda-setting process during the early years when the issue was new and fluid. Our study contributes to the scholarship on bureaucratic access in Congress and offers new theoretical insights and empirical measures to gauge bureaucratic multifaceted strength in the national policy agendasetting process.},
	pages = {833--851},
	number = {4},
	journaltitle = {Policy Studies Journal},
	shortjournal = {Policy Studies Journal},
	author = {Liu, Xinsheng and Hannibal, Bryce and Vedlitz, Arnold},
	urldate = {2026-08-25},
	date = {2025-11},
	langid = {english},
	keywords = {notion, research interest, bureaucracy, reading application},
	file = {Liu et al.-2025-Policy Studies Journal-Bureaucratic Access in National Policy Agenda Setting Process Participation, dispersion, and centra.pdf:/Users/jodypark/Library/CloudStorage/Dropbox/Zotero/Penn State/Fall 2026/PLSC508 Political Networks/Liu et al.-2025-Policy Studies Journal-Bureaucratic Access in National Policy Agenda Setting Process Participation, dispersion, and centra.pdf:application/pdf},
}



@article{acs2025,
	title = {Mapping the Political Contours of the Regulatory State: Dynamic Estimates of Agency Ideal Points},
	rights = {http://creativecommons.org/licenses/by/4.0},
	issn = {0003-0554, 1537-5943},
	url = {https://www.cambridge.org/core/product/identifier/S0003055425101391/type/journal_article},
	doi = {10.1017/S0003055425101391},
	shorttitle = {Mapping the Political Contours of the Regulatory State},
	abstract = {This article introduces a novel empirical method for estimating the ideological orientations of U.S. regulatory agencies across different presidential administrations. Employing a measurement model based on item response theory and analyzing data on planned regulations from the Unified Agenda and the president’s discretionary review of those regulations, as implemented by the Office of Information and Regulatory Affairs, the study provides dynamic estimates of agency ideal points from the Clinton through the Trump administrations. The model uses {NOMINATE} ideal points of presidents to link the estimated agency ideal points to legislative ideal points. The resulting estimates correlate positively with existing measures of agency ideology, highlight controversial regulators, and demonstrate that agency ideologies shift over time due to emerging issues that divide the parties. The study also finds that agencies located ideologically closer to the president are more productive, as evidenced by their regulatory output.},
	pages = {1--18},
	journaltitle = {American Political Science Review},
	shortjournal = {Am Polit Sci Rev},
	author = {Acs, Alex},
	urldate = {2025-12-22},
	date = {2025-12-17},
	langid = {english},
	keywords = {Ideology, notion, research interest, game theory, Dan},
	file = {Acs-2025-American Political Science Review-Mapping the Political Contours of the Regulatory State Dynamic Estimates of Agency Ideal Points.pdf:/Users/jodypark/Library/CloudStorage/Dropbox/Zotero/Political Science/Bureaucratic ideology-Institutional Outcome/Acs-2025-American Political Science Review-Mapping the Political Contours of the Regulatory State Dynamic Estimates of Agency Ideal Points.pdf:application/pdf;Acs-2025-American Political Science Review-Mapping the Political Contours of the Regulatory State Dynamic Estimates of Agency Ideal Points.pdf:/Users/jodypark/Library/CloudStorage/Dropbox/Zotero/Political Science/Bureaucratic ideology-Institutional Outcome/Acs-2025-American Political Science Review-Mapping the Political Contours of the Regulatory State Dynamic Estimates of Agency Ideal Points.pdf:application/pdf},
}




@article{selin2015,
	title = {What Makes an Agency Independent?},
	volume = {59},
	issn = {0092-5853, 1540-5907},
	url = {https://onlinelibrary.wiley.com/doi/10.1111/ajps.12161},
	doi = {10.1111/ajps.12161},
	abstract = {The responsiveness of government agencies to elected officials is a central question in democratic governance. A key source of variation in responsiveness is agency structure. Yet scholars often view agencies as falling into broad structural categories (e.g., cabinet departments or independent commissions) or fixate on some features of design (e.g., “for cause” protections). I develop new estimates of structural independence based on new data on 50 different structural features of 321 federal agencies in the federal executive establishment. Using a Bayesian latent variable model, I estimate independence on two dimensions: limits on the appointment of key agency decision makers and limits on political review of agency policy. I illustrate the value of this new measure by using it to examine how structure affects political influence and how agency independence can vary over time.},
	pages = {971--987},
	number = {4},
	journaltitle = {American Journal of Political Science},
	shortjournal = {American J Political Sci},
	author = {Selin, Jennifer L.},
	urldate = {2026-01-18},
	date = {2015-10},
	langid = {english},
	keywords = {notion},
	file = {Selin-2015-American Journal of Political Science-What Makes an Agency Independent.pdf:/Users/jodypark/Library/CloudStorage/Dropbox/Zotero/Political Science/Bureaucratic ideology-Institutional Outcome/Selin-2015-American Journal of Political Science-What Makes an Agency Independent.pdf:application/pdf},
}



@article{soss2006,
	title = {The Political Roots of Disability Claims: How State Environments and Policies Shape Citizen Demands},
	volume = {59},
	issn = {1065-9129},
	url = {https://doi.org/10.1177/106591290605900112},
	doi = {10.1177/106591290605900112},
	shorttitle = {The Political Roots of Disability Claims},
	abstract = {Who gets what from government is partly determined by who applies for government programs. Despite the importance of the claiming process, political scientists have said little about the factors that influence citizen demands on government programs. We explore the hypothesis that state environments systematically shape aggregate rates of welfare demand making by testing a model of welfare claiming in the Social Security Disability Insurance and the Supplemental Security Income programs. Our findings show that in addition to economic need for benefits, the density of civil society organizations, the political ideology of state officials, and the generosity of state-run public assistance programs shape the amount and direction of citizen demands on the welfare system. Although commonalities exist in which variables explain welfare claiming, relationships vary in interesting ways across programs and stages of the claiming process, highlighting the need for a theoretical model of claiming behavior that takes into account such differences.},
	pages = {133--148},
	number = {1},
	journaltitle = {Political Research Quarterly},
	publisher = {{SAGE} Publications Inc},
	author = {Soss, Joe and Keiser, Lael R.},
	urldate = {2025-11-13},
	date = {2006-03-01},
	langid = {american},
	keywords = {notion, research interest, writing, Tracee},
	file = {Soss and Keiser-2006-Political Research Quarterly-The Political Roots of Disability Claims How State Environments and Policies Shape Citizen Demands.pdf:/Users/jodypark/Library/CloudStorage/Dropbox/Zotero/Political Science/Bureaucracy/Soss and Keiser-2006-Political Research Quarterly-The Political Roots of Disability Claims How State Environments and Policies Shape Citizen Demands.pdf:application/pdf},
}



